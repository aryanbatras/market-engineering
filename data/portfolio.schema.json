{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market Engineering portfolio",
  "type": "object",
  "properties": {
    "portfolioVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "headline": {
          "type": "string",
          "maxLength": 160
        },
        "photo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "const": ""
            }
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            {
              "type": "string",
              "const": ""
            }
          ]
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "availability": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "links": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "github",
              "linkedin",
              "twitter",
              "website",
              "email",
              "dribbble",
              "behance",
              "youtube",
              "instagram"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "platform",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "degree": {
            "type": "string",
            "maxLength": 160
          },
          "field": {
            "type": "string",
            "maxLength": 160
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "current": {
            "default": false,
            "type": "boolean"
          },
          "grade": {
            "type": "string",
            "maxLength": 80
          },
          "board": {
            "type": "string",
            "maxLength": 80
          },
          "score": {
            "type": "string",
            "maxLength": 40
          },
          "details": {
            "type": "string",
            "maxLength": 800
          }
        },
        "required": [
          "institution",
          "current"
        ],
        "additionalProperties": false
      }
    },
    "experience": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "current": {
            "default": false,
            "type": "boolean"
          },
          "start": {
            "type": "string",
            "pattern": "^(\\d{4}(-\\d{2})?)$"
          },
          "end": {
            "type": "string",
            "pattern": "^(\\d{4}(-\\d{2})?)$"
          },
          "summary": {
            "type": "string",
            "maxLength": 1200
          },
          "highlights": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "organisation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "maxLength": 160
          },
          "location": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "default": "full-time",
            "type": "string",
            "enum": [
              "internship",
              "full-time",
              "volunteer"
            ]
          }
        },
        "required": [
          "current",
          "start",
          "highlights",
          "organisation",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 1200
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "repo": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "tech": {
            "default": [],
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "const": ""
              }
            ]
          },
          "role": {
            "type": "string",
            "maxLength": 160
          },
          "timeline": {
            "type": "string",
            "maxLength": 120
          },
          "featured": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "tech",
          "featured"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": [],
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "group": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "highlights": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "languages": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "proficiency": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "maxLength": 80
        },
        "lastSyncedAt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "templateId": {
          "type": "string",
          "maxLength": 60
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "portfolioVersion",
    "identity",
    "links",
    "education",
    "experience",
    "projects",
    "skills",
    "highlights",
    "languages"
  ],
  "additionalProperties": false,
  "$defs": {
    "templateConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accent": {
          "default": "blue",
          "type": "string",
          "enum": [
            "blue",
            "ink"
          ]
        },
        "density": {
          "default": "comfortable",
          "type": "string",
          "enum": [
            "compact",
            "comfortable"
          ]
        },
        "dark": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "accent",
        "density",
        "dark"
      ],
      "additionalProperties": false
    }
  }
}
